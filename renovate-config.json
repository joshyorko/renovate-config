{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "onboarding": false,
  "platform": "github",
  "autodiscover": true,
  "autodiscoverFilter": [
    "joshyorko/camp",
    "joshyorko/dsb-common",
    "joshyorko/dudley-factory",
    "joshyorko/dudley-os",
    "joshyorko/homebrew-tools",
    "joshyorko/rcc",
    "joshyorko/review",
    "joshyorko/room-of-requirement"
  ],
  "allowedCommands": [
    "^node developer/update_dependency_locks\\.mjs$",
    "^node scripts/update-omp-pins\\.mjs$",
    "^node scripts/update-gh-pins\\.mjs$",
    "^node scripts/update-requirements-ci-hashes\\.mjs$"
  ],
  "requireConfig": "required",
  "inheritConfig": true,
  "inheritConfigRepoName": "joshyorko/renovate-config",
  "inheritConfigFileName": "org-inherited-config.json",
  "inheritConfigStrict": true
}
