{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits"
  ],
  "branchPrefix": "patchraptor/",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Patchraptor Dependency Dashboard",
  "rebaseWhen": "auto",
  "prCreation": "immediate",
  "prHourlyLimit": 0,
  "platformAutomerge": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the executor deployment image tag and digest pair in tunnel-kit's production image manifest.",
      "managerFilePatterns": [
        "/^config\\/deploy-images\\.json$/"
      ],
      "matchStrings": [
        "\\\"executor\\\"\\s*:\\s*\\{\\s*\\\"repository\\\"\\s*:\\s*\\\"(?<depName>ghcr\\.io/usefulsoftwareco/executor-selfhost):(?<currentValue>[^\\\"@]+)\\\"\\s*,\\s*\\\"digest\\\"\\s*:\\s*\\\"(?<currentDigest>sha256:[a-f0-9]{64})\\\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "{{{depName}}}:{{#if newValue}}{{{newValue}}}{{else}}{{{currentValue}}}{{/if}}{{#if newDigest}}@{{{newDigest}}}{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Track the version-prefixed tunnel deployment image tag and digest pair in tunnel-kit's production image manifest.",
      "managerFilePatterns": [
        "/^config\\/deploy-images\\.json$/"
      ],
      "matchStrings": [
        "\\\"tunnel\\\"\\s*:\\s*\\{\\s*\\\"repository\\\"\\s*:\\s*\\\"(?<depName>ghcr\\.io/openai/tunnel-client):v(?<currentValue>[^\\\"@]+)\\\"\\s*,\\s*\\\"digest\\\"\\s*:\\s*\\\"(?<currentDigest>sha256:[a-f0-9]{64})\\\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "{{{depName}}}:v{{#if newValue}}{{{newValue}}}{{else}}{{{currentValue}}}{{/if}}{{#if newDigest}}@{{{newDigest}}}{{/if}}"
    }
  ],
  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": [
        "pin",
        "pinDigest"
      ]
    },
    {
      "automerge": true,
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "digest"
      ]
    },
    {
      "automerge": true,
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest"
      ]
    },
    {
      "groupName": "GitHub Actions",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "description": [
        "SLSA reusable workflows must be referenced by tag instead of SHA."
      ],
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "slsa-framework/slsa-github-generator"
      ],
      "pinDigests": false
    },
    {
      "description": [
        "Dagger's Go SDK is generated from dagger.json with dagger develop, so do not update dagger.io/dagger as a plain Go module."
      ],
      "enabled": false,
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "dagger.io/dagger"
      ]
    },
    {
      "description": [
        "Dagger module dependencies import generated internal/dagger code, so generic Go module artifact updates fail without running dagger develop first."
      ],
      "enabled": false,
      "matchFileNames": [
        ".dagger/go.mod"
      ],
      "matchManagers": [
        "gomod"
      ]
    },
    {
      "description": [
        "CAS and tunnel-kit changes carry native runtime or production deployment risk; never inherit Patchraptor's central automerge rules."
      ],
      "matchRepositories": [
        "joshyorko/codex-action-server",
        "joshyorko/mcp-tunnel-kit"
      ],
      "automerge": false,
      "platformAutomerge": false
    },
    {
      "description": [
        "CAS toolchain, Python runtime, base image, and GitHub Actions upgrades require dashboard approval and successful repository CI before a PR is opened."
      ],
      "matchRepositories": [
        "joshyorko/codex-action-server"
      ],
      "matchManagers": [
        "dockerfile",
        "github-actions",
        "pep621",
        "pip_requirements"
      ],
      "dependencyDashboardApproval": true,
      "prCreation": "status-success",
      "automerge": false,
      "platformAutomerge": false
    },
    {
      "description": [
        "Tunnel-kit image and workflow updates require dashboard approval and successful repository CI before a PR is opened."
      ],
      "matchRepositories": [
        "joshyorko/mcp-tunnel-kit"
      ],
      "matchManagers": [
        "custom.regex",
        "docker-compose",
        "dockerfile",
        "github-actions"
      ],
      "dependencyDashboardApproval": true,
      "prCreation": "status-success",
      "automerge": false,
      "platformAutomerge": false
    },
    {
      "description": [
        "Only the trusted CAS promotion handoff may update the production CAS image and its source revision."
      ],
      "matchRepositories": [
        "joshyorko/mcp-tunnel-kit"
      ],
      "matchPackageNames": [
        "ghcr.io/joshyorko/codex-action-server"
      ],
      "enabled": false
    },
    {
      "description": [
        "Keep tunnel-kit's tracked deployment image updates grouped across image manifest and Compose references."
      ],
      "matchRepositories": [
        "joshyorko/mcp-tunnel-kit"
      ],
      "matchPackageNames": [
        "ghcr.io/usefulsoftwareco/executor-selfhost",
        "ghcr.io/openai/tunnel-client"
      ],
      "groupName": "Tunnel-kit deployment images",
      "dependencyDashboardApproval": true,
      "prCreation": "status-success",
      "automerge": false,
      "platformAutomerge": false
    }
  ]
}
